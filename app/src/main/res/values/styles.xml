<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/fg_secondary</item>
        <item name="android:textColorHint">@color/fg_muted</item>
        <item name="android:textColorHighlight">@color/bg_selected</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlNormal">@color/fg_muted</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <style name="AppDialog" parent="android:Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorBackground">@color/bg_raised</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/fg_secondary</item>
        <item name="android:textColorHighlight">@color/bg_selected</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
